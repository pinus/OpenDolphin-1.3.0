<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoders are assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="open.dolphin.client.KarteDocumentViewerWorker" level="DEBUG" />
    <logger name="open.dolphin.client.KarteDocumentViewer" level="DEBUG" />
    <logger name="open.dolphin.client.KarteViewer2" level="DEBUG" />
    <logger name="open.dolphin.client.DocumentModelCache" level="DEBUG" />
    <logger name="open.dolphin.client.KarteRenderer_2" level="INFO" />
    <logger name="open.dolphin.client.KartePaneDumper_2" level="INFO" />
</configuration>
